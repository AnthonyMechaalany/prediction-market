<%- include('../partials/header') %>

<div class="container">
  <div class="market-show-page">

    <div class="market-header">
      <div class="market-meta">
        <span class="badge badge-<%= market.category %>"><%= market.category %></span>
        <span class="badge badge-<%= market.status %>"><%= market.status %></span>
      </div>
      <h1><%= market.question %></h1>
      <p class="market-description"><%= market.description %></p>

      <div class="market-details">
        <span><i class="ti ti-clock"></i> Closes: <%= new Date(market.closeAt).toLocaleString() %></span>
        <span><i class="ti ti-users"></i> <%= market.bets.length %> bets</span>
        <span><i class="ti ti-coins"></i> <%= market.totalPool.toLocaleString() %> pts pool</span>
        <span>Created by <a href="/users/<%= market.author._id %>"><%= market.author.username %></a></span>
      </div>
    </div>

    <div class="market-body">
      <div class="market-stats">
        <div class="stat-card yes-card">
          <span class="stat-label">YES</span>
          <span class="stat-value"><%= market.yesPercentage %>%</span>
          <span class="stat-sub"><%= market.yesBets %> bets · <%= market.yesPool.toLocaleString() %> pts</span>
        </div>
        <div class="stat-card no-card">
          <span class="stat-label">NO</span>
          <span class="stat-value"><%= market.noPercentage %>%</span>
          <span class="stat-sub"><%= market.noBets %> bets · <%= market.noPool.toLocaleString() %> pts</span>
        </div>
      </div>

      <% if (currentUser) { %>
        <div class="bet-section">
          <% if (userBet) { %>
            <div class="your-bet">
              <h3>Your Bet</h3>
              <div class="bet-summary">
                <span>Prediction: <strong class="pred-<%= userBet.prediction.toLowerCase() %>"><%= userBet.prediction %></strong></span>
                <span>Amount: <strong><%= userBet.amount.toLocaleString() %> pts</strong></span>
                <span>Status: <span class="badge badge-<%= userBet.status %>"><%= userBet.status %></span></span>
                <% if (userBet.status === 'won') { %>
                  <span class="payout-won">🎉 Payout: +<%= userBet.payout.toLocaleString() %> pts</span>
                <% } else if (userBet.status === 'lost') { %>
                  <span class="payout-lost">💸 Lost: -<%= userBet.amount.toLocaleString() %> pts</span>
                <% } %>
              </div>
              <% if (market.status === 'open') { %>
                <form action="/bets/<%= userBet._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Cancel bet and get refund?')">
                  <button class="btn btn-danger btn-sm">Cancel Bet (Refund)</button>
                </form>
              <% } %>
            </div>
          <% } else if (market.status === 'open') { %>
            <div class="bet-form-section">
              <h3>Place Your Bet</h3>
              <p>You have <strong><%= currentUser.points.toLocaleString() %> points</strong> available.</p>
              <form action="/bets" method="POST" class="bet-form">
                <input type="hidden" name="marketId" value="<%= market._id %>"/>
                <div class="bet-predictions">
                  <label class="pred-btn yes-btn">
                    <input type="radio" name="prediction" value="YES" required/> YES
                  </label>
                  <label class="pred-btn no-btn">
                    <input type="radio" name="prediction" value="NO" required/> NO
                  </label>
                </div>
                <div class="bet-amount-row">
                  <input type="number" name="amount" min="10" max="<%= currentUser.points %>" placeholder="Points to bet (min 10)" class="input-bet" required/>
                  <button type="submit" class="btn btn-primary">Place Bet</button>
                </div>
              </form>
            </div>
          <% } else if (market.status === 'closed') { %>
            <div class="bet-form-section">
              <h3>⏰ Market Closed</h3>
              <p style="color: var(--text2);">This market has closed and is awaiting resolution by an admin. Check back soon to see the outcome.</p>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="bet-form-section">
          <p><a href="/login">Log in</a> to place a bet on this market.</p>
        </div>
      <% } %>

      <div class="market-bets-list">
        <h3>Recent Bets</h3>
        <% if (market.bets.length === 0) { %>
          <p class="empty-state">No bets yet. Be the first!</p>
        <% } else { %>
          <ul class="bets-list">
            <% market.bets.slice(0, 10).forEach(bet => { %>
              <li class="bet-item">
                <span class="bet-user"><a href="/users/<%= bet.user._id %>"><%= bet.user.username %></a></span>
                <span class="pred-<%= bet.prediction.toLowerCase() %>"><%= bet.prediction %></span>
                <span class="bet-amt"><%= bet.amount.toLocaleString() %> pts</span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <% if (currentUser && currentUser._id.equals(market.author._id)) { %>
        <div class="market-admin-actions">
          <h3>Market Actions</h3>
          <% if (market.status === 'open' || market.status === 'closed') { %>
            <form action="/markets/<%= market._id %>/resolve" method="POST" class="resolve-form">
              <p>Resolve this market:</p>
              <div class="resolve-btns">
                <button name="outcome" value="YES" class="btn btn-yes">Resolve YES</button>
                <button name="outcome" value="NO" class="btn btn-no">Resolve NO</button>
              </div>
            </form>
          <% } %>
          <form action="/markets/<%= market._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this market?')">
            <button class="btn btn-danger btn-sm">Delete Market</button>
          </form>
        </div>
      <% } %>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
