<%- include('../partials/header') %>

<div class="container page-container">
  <div class="back-link"><a href="/markets/<%= market._id %>">← Back to Market</a></div>
  <h1>Edit Market</h1>

  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <form action="/markets/<%= market._id %>?_method=PUT" method="POST" class="form-card">
    <div class="form-group">
      <label>Title *</label>
      <input type="text" name="title" value="<%= market.title %>" required minlength="5" maxlength="200" class="input"/>
    </div>
    <div class="form-group">
      <label>Description *</label>
      <textarea name="description" rows="4" required maxlength="1000" class="input textarea"><%= market.description %></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Category</label>
        <select name="category" class="input select">
          <% ['politics','sports','technology','entertainment','science','economics','other'].forEach(cat => { %>
            <option value="<%= cat %>" <%= market.category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase()+cat.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Closes At *</label>
        <input type="datetime-local" name="closesAt" value="<%= new Date(market.closesAt).toISOString().slice(0,16) %>" required class="input"/>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/markets/<%= market._id %>" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
