<%- include('../partials/header') %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo">PREDICT<span>IT</span></div>
    <h2>Welcome Back</h2>

    <% if (error) { %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>

    <form action="/auth/login" method="POST" class="auth-form">
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" placeholder="your@email.com" required class="input"/>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Your password" required class="input"/>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Login</button>
    </form>

    <p class="auth-link">No account? <a href="/auth/register">Register (get 1,000 pts free)</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
