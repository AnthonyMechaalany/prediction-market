<%- include('../partials/header') %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo">PREDICT<span>IT</span></div>
    <h2>Create Account</h2>
    <p class="auth-sub">Start with <strong>1,000 free points</strong></p>

    <% if (error) { %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>

    <form action="/auth/register" method="POST" class="auth-form">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" placeholder="Choose a username" required minlength="3" class="input"/>
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" placeholder="your@email.com" required class="input"/>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Min 6 characters" required minlength="6" class="input"/>
      </div>
      <div class="form-group">
        <label>Confirm Password</label>
        <input type="password" name="confirmPassword" placeholder="Repeat password" required class="input"/>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Register</button>
    </form>

    <p class="auth-link">Already have an account? <a href="/auth/login">Login</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
