<%- include('../partials/header') %>

<div class="container page-container">
  <div class="page-header">
    <h1>Manage Users <span class="count-badge"><%= users.length %></span></h1>
  </div>

  <table class="table">
    <thead>
      <tr><th>Username</th><th>Email</th><th>Role</th><th>Points</th><th>Joined</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% users.forEach(user => { %>
      <tr>
        <td><strong><%= user.username %></strong></td>
        <td><%= user.email %></td>
        <td><span class="role-badge role-<%= user.role %>"><%= user.role %></span></td>
        <td><%= user.points.toLocaleString() %> pts</td>
        <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
        <td class="actions-cell">
          <a href="/users/<%= user._id %>" class="btn btn-ghost btn-xs">View</a>
          <a href="/users/<%= user._id %>/edit" class="btn btn-ghost btn-xs">Edit</a>
          <% if (user._id.toString() !== currentUser._id.toString()) { %>
            <form action="/users/<%= user._id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Delete this user?')">
              <button class="btn btn-danger btn-xs">Delete</button>
            </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
