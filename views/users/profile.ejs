<%- include('../partials/header') %>

<div class="container page-container">
  <div class="user-profile-header">
    <div class="user-avatar-lg"><%= user.username.charAt(0).toUpperCase() %></div>
    <div>
      <h1><%= user.username %> <span class="role-badge role-<%= user.role %>"><%= user.role %></span></h1>
      <p><%= user.email %></p>
      <p>Member since <%= new Date(user.createdAt).toLocaleDateString() %></p>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stat-card accent-green"><div class="stat-val"><%= user.points.toLocaleString() %></div><div class="stat-label">⬡ Points</div></div>
    <div class="stat-card"><div class="stat-val"><%= stats.total %></div><div class="stat-label">Total Bets</div></div>
    <div class="stat-card accent-green"><div class="stat-val"><%= stats.won %></div><div class="stat-label">Won 🎉</div></div>
    <div class="stat-card accent-red"><div class="stat-val"><%= stats.lost %></div><div class="stat-label">Lost 💸</div></div>
  </div>

  <div class="stats-grid small">
    <div class="stat-card"><div class="stat-val"><%= stats.pending %></div><div class="stat-label">Pending ⏳</div></div>
    <div class="stat-card accent-green"><div class="stat-val">+<%= stats.totalWon.toLocaleString() %></div><div class="stat-label">Points Won</div></div>
    <div class="stat-card accent-red"><div class="stat-val">-<%= stats.totalLost.toLocaleString() %></div><div class="stat-label">Points Lost</div></div>
    <div class="stat-card">
      <div class="stat-val"><%= stats.total > 0 ? Math.round(stats.won/stats.total*100) : 0 %>%</div>
      <div class="stat-label">Win Rate</div>
    </div>
  </div>

  <h2>My Bets</h2>
  <% if (bets.length === 0) { %>
    <div class="empty-state">No bets yet. <a href="/markets">Browse markets →</a></div>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Market</th><th>Category</th><th>Prediction</th><th>Amount</th><th>Status</th><th>Result</th></tr></thead>
      <tbody>
        <% bets.forEach(bet => { %>
        <tr>
          <td><a href="/markets/<%= bet.market._id %>"><%= bet.market.title.substring(0,45) %>...</a></td>
          <td><span class="market-cat cat-<%= bet.market.category %>"><%= bet.market.category %></span></td>
          <td><span class="badge badge-<%= bet.prediction.toLowerCase() %>"><%= bet.prediction %></span></td>
          <td><%= bet.amount.toLocaleString() %></td>
          <td><span class="badge badge-<%= bet.status %>"><%= bet.status %></span></td>
          <td>
            <% if (bet.status==='won') { %><span class="text-green">+<%= bet.payout.toLocaleString() %></span>
            <% } else if (bet.status==='lost') { %><span class="text-red">-<%= bet.amount.toLocaleString() %></span>
            <% } else { %>—<% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
